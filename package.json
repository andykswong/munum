{
  "name": "munum",
  "version": "0.3.0",
  "description": "Micro 3D Math Library for JavaScript and WebAssembly",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=26.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./js": "./dist/js/index.js",
    "./wasm": "./wasm/index.js",
    "./wasm/module": "./wasm/munum.wasm",
    "./wasm/component": "./wasm/munum.component.wasm"
  },
  "files": [
    "/dist",
    "/wasm",
    "/wit"
  ],
  "scripts": {
    "prepublishOnly": "npm run clean && npm run build && npm test && npm run doc",
    "clean": "rimraf coverage docs dist *.tsbuildinfo target",
    "build": "npm run build:wasm && npm run build:wasm-opt && npm run build:wasm-loader && npm run build:component && npm run build:js",
    "build:wasm": "cargo rustc -r --target wasm32-unknown-unknown --crate-type cdylib -F jsmath,wasm --no-default-features",
    "build:wasm-opt": "wasm-opt -Oz -o wasm/munum.wasm target/wasm32-unknown-unknown/release/munum.wasm",
    "build:wasm-loader": "node scripts/gen-wasm-loader.mjs",
    "build:component": "jco embed -o wasm/munum.component.wasm --world-name root --wit wit/world.wit wasm/munum.wasm && jco new -o wasm/munum.component.wasm wasm/munum.component.wasm",
    "build:js": "vite build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "test:rust": "cargo test --all-features",
    "doc": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andykswong/munum.git"
  },
  "keywords": [
    "numeric",
    "matrix",
    "math",
    "typescript",
    "vector",
    "webassembly",
    "wasm"
  ],
  "author": "Andy K.S. Wong <andykswong@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andykswong/munum/issues"
  },
  "homepage": "https://github.com/andykswong/munum",
  "dependencies": {
    "libmath": "^0.1"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.25",
    "@eslint/js": "^10.0",
    "@stylistic/eslint-plugin": "^5.0",
    "@types/node": "^26.0",
    "@vitest/browser-playwright": "^4.1",
    "@vitest/coverage-v8": "^4.1.10",
    "binaryen": "^130.0",
    "eslint": "^10.0",
    "globals": "^17.0",
    "playwright": "^1.61",
    "rimraf": "^6.0",
    "typedoc": "^0.28",
    "typescript": "^6.0",
    "typescript-eslint": "^8.50",
    "vite": "^8.1",
    "vite-plugin-dts": "^5.0",
    "vitest": "^4.1"
  },
  "workspaces": [
    "packages/libmath"
  ]
}
